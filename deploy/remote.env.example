# Single-owner hackathon bearer profile. No file is loaded automatically.
# No secrets, credentials, accounts or persistent access are created here.
# Actual credential creation/provisioning and Fo registration need approval.
FO_FIX_MODE=remote
FO_FIX_AUTH_MODE=bearer
FO_FIX_PUBLIC_ORIGIN=
FO_FIX_BACKEND=fixture
# Conventional private upstream: allow only the provider's verified proxy IPs.
FO_FIX_LISTEN_HOST=0.0.0.0
FO_FIX_TRUST_PROXY=addresses
FO_FIX_PROXY_ADDRESSES=
# PORT is read from the host; FO_FIX_PORT overrides it, otherwise defaults 4310.
# FO_FIX_PORT=4310
# SHA-256 hex digests only; independent random credentials, 32+ random bytes
# encoded base64url (43-128 characters). Never use a memorable password.
FO_FIX_MCP_TOKEN_SHA256=
FO_FIX_OWNER_TOKEN_SHA256=
# Absolute UTC ISO timestamp in the next 24 hours. No automatic renewal.
FO_FIX_ACCESS_EXPIRES_AT=
# For same-host TLS instead: LISTEN_HOST=127.0.0.1, TRUST_PROXY=loopback,
# omit PROXY_ADDRESSES. Never trust every proxy or arbitrary forwarded headers.
# Optional absolute persistent private fixture path (default .fo-fix/fixture.sqlite).
# FO_FIX_DATA=/approved-private-volume/fixture.sqlite
# Session mode additionally requires these, with a third distinct credential:
# FO_FIX_DEVICE_ID=
# FO_FIX_COMPANION_TOKEN_SHA256=
# Optional, session backend only: relay Mac folder tools (files.*, slides.create,
# files.share_download). Folders and their lease stay on the Mac; see
# docs/FOLDER-TOOLS.md. The gateway refuses --allow-folder.
# FO_FIX_FILES_ENABLED=1
