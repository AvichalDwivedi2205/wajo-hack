# Run on the Mac (or a separately labelled local fixture process), manually.
# Start its loopback companion first. No daemon/autostart is installed.
FO_FIX_PORT=4310
FO_FIX_GATEWAY_ORIGIN=
FO_FIX_DEVICE_ID=
# Previously authorized companion credential for this deployment only.
# Bearer mode: third independent credential matching COMPANION_TOKEN_SHA256.
# Optional OAuth mode: access token, fofix:companion, audience <origin>/session.
# Do not reuse an MCP or owner token. Do not paste a token into a command line.
FO_FIX_COMPANION_ACCESS_TOKEN=
# If using an existing outbound proxy, preserve its authorized configuration
# and make sure loopback traffic is excluded. No proxy values belong here.
# NO_PROXY=127.0.0.1,localhost,::1
