# Optional advanced OAuth profile. Fo compatibility requires curated provider or DCR, not merely an issuer.
# Configuration only. Nothing loads this file automatically.
# Supply actual values through the approved host environment/secret manager.
# No issuer, clients, credentials, certificate or account is created by Fo Fix.
FO_FIX_MODE=remote
FO_FIX_AUTH_MODE=oauth
FO_FIX_PORT=4310
# Exact HTTPS origin with no path, query, userinfo or fragment.
FO_FIX_PUBLIC_ORIGIN=
FO_FIX_TRUST_PROXY=loopback
FO_FIX_LISTEN_HOST=127.0.0.1
# Explicitly choose fixture first, or session for a separate local companion.
FO_FIX_BACKEND=fixture
# One approved OAuth authorization server; these endpoint origins must match.
FO_FIX_AUTH_ISSUER=
FO_FIX_AUTH_JWKS_URL=
FO_FIX_OWNER_AUTHORIZATION_URL=
FO_FIX_OWNER_TOKEN_URL=
# Distinct registered OAuth client IDs. These are identifiers, not passwords.
FO_FIX_OWNER_CLIENT_ID=
FO_FIX_MCP_CLIENT_ID=
FO_FIX_OWNER_SUBJECT=
# Required only for FO_FIX_BACKEND=session.
FO_FIX_COMPANION_CLIENT_ID=
FO_FIX_DEVICE_ID=
# Optional fixture journal path; session mode keeps the device journal on device.
FO_FIX_DATA=
# Optional model smoke test only. Never needed by the repair engine.
ANTHROPIC_API_KEY=
