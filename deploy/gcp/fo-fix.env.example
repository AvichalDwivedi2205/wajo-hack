# Install filled copy at /etc/fo-fix/fo-fix.env only after approval.
# Root-owned 0600; systemd reads it. No plaintext credentials belong here.
NODE_ENV=production
FO_FIX_MODE=remote
FO_FIX_AUTH_MODE=bearer
FO_FIX_BACKEND=fixture
FO_FIX_PORT=4310
FO_FIX_LISTEN_HOST=127.0.0.1
FO_FIX_TRUST_PROXY=loopback
# Exact https://approved-owned-hostname; no path or query.
FO_FIX_PUBLIC_ORIGIN=
# Mount the approved persistent data disk here before starting the service.
FO_FIX_DATA=/var/lib/fo-fix/fixture.sqlite
# Distinct digests of independently approved random credentials; not passwords.
FO_FIX_MCP_TOKEN_SHA256=
FO_FIX_OWNER_TOKEN_SHA256=
# UTC ISO timestamp within 24 hours; no renewal is performed automatically.
FO_FIX_ACCESS_EXPIRES_AT=
