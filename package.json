{
  "name": "fo-fix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --import tsx src/server/main.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx src/server/main.ts --production",
    "start:remote": "node --use-env-proxy --import tsx src/server/main.ts --remote",
    "companion": "node --import tsx src/server/main.ts --macos",
    "mcp": "node --import tsx src/server/stdio.ts",
    "companion:connect": "node --use-env-proxy --import tsx src/companion/connect.ts",
    "diagnostics": "node --import tsx scripts/diagnostics.ts",
    "diagnostics:network": "node --use-env-proxy --import tsx scripts/diagnostics.ts --network",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:haiku": "node scripts/haiku-smoke.mjs",
    "check": "npm run build && npm test && npm run test:e2e",
    "macos:build": "bash companion/macos/build.sh",
    "review:demo": "npm run review:setup && node --import tsx src/server/main.ts --production --review-demo",
    "review:dev": "npm run review:setup && node --import tsx src/server/main.ts --review-demo",
    "review:setup": "node --import tsx scripts/setup-review-demo.ts",
    "review:fixtures": "node --import tsx scripts/create-review-demo.ts",
    "test:review": "node --import tsx --test tests/review*.test.ts",
    "test:review:e2e": "playwright test tests/browser/review.spec.ts",
    "macos:review:build": "bash companion/macos/build-review.sh",
    "review:native:audit": "node --import tsx scripts/review-native-audit.ts",
    "review:seed": "node --import tsx scripts/create-keynote-seed.ts",
    "review:bind-native": "node --import tsx scripts/bind-native-review.ts",
    "review:pptx:setup": "node --import tsx scripts/setup-pptx-review.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.2.1",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "jose": "6.2.12",
    "lucide-react": "0.577.0",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/node": "24.12.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
